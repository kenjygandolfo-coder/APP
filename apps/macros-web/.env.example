# Supabase configuration for apps/macros-web.
# Copy this file to .env and fill in the values from your Supabase project.
#
# The anon (public) key below is PUBLIC BY DESIGN: it ships to the browser and
# access is gated by Row Level Security. It is safe to share.
#
# NEVER commit a real .env, and NEVER put a service_role key (or any other
# secret) here or anywhere in the client bundle.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
